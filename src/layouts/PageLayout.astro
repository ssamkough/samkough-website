---
import Layout from "../layouts/Layout.astro";
const { title, wide = false } = Astro.props;
---

<Layout title={title}>
  <div class:list={["container", { wide }]}>
    <header>
      <a href="/">Home</a>
      <h1>{title}</h1>
    </header>
    <main>
      <slot />
    </main>
    <!-- <hr /> -->
    <!-- <footer></footer> -->
  </div>
</Layout>

<style>
  .container {
    width: 100%;
    max-width: 65ch;
    margin-inline: auto;
  }

  .container.wide {
    max-width: none;
  }
</style>
